#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ВариантОтчета	= "Заказы_Номенклатура";
	ИсточникЗаказов = "Все";

	Об = РеквизитФормыВЗначение("Отчет");
	
	СКД = Об.ПолучитьМакет("Отбор_Заказы");
	
	АдресСхемы = ПоместитьВоВременноеХранилище(СКД, Новый УникальныйИдентификатор());
	
	ОтборЗаказы.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемы));
	
	НастройкиПоУмолчанию = СКД.НастройкиПоУмолчанию;
	
	ОтборЗаказы.ЗагрузитьНастройки(НастройкиПоУмолчанию);
	
	Если НЕ РольДоступна("ПолныеПрава")
		И НЕ QWERTY_Привилегированный.ПрофильДоступен(Справочники.ПрофилиГруппДоступа.Бухгалтер)
		Тогда
		Элементы.СтраницаЗарплатаПоМенеджерам.Видимость = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПереключитьВидимостьСтраниц();
КонецПроцедуры

&НаКлиенте
Процедура ВариантОтчетаПриИзменении(Элемент)
	ПереключитьВидимостьСтраниц();
КонецПроцедуры

&НаКлиенте
Процедура СформироватьОтчет(Команда)

	ПереключитьВидимостьСтраниц();
	
	РасшифровкаЗаказ = "";
	
	Если ВариантОтчета = "Заказы_Номенклатура" Тогда
		Результат = СформироватьОтчетНаСервереЗаказыНоменклатура();
		СформироватьОтчетЗарплатаПоМенеджерам();
	ИначеЕсли ВариантОтчета = "Номенклатура_Заказы" Тогда
		СформироватьОтчетНаСервереНоменклатураЗаказы();
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(ЭтаФорма.Элементы.Результат, "НЕИСПОЛЬЗОВАТЬ");
	
КонецПроцедуры

#КонецОбласти

#Область СобратьДанные

Функция ПолучитьЗначениеДопРеквизитаСкладской(п_Заказ)
	
	Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Складской (Список заказов клиентов)");
	
	Рез = УправлениеСвойствами.ЗначениеСвойства(п_Заказ, Свойство);
	
	Возврат Рез;

КонецФункции // ()

Функция ЕстьРасходПрошлыхПериодов(п_Заказ, п_ДатаНачала)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПриобретениеУслугПрочихАктивовРасходы.Ссылка.Дата КАК Дата,
		|	ПриобретениеУслугПрочихАктивовРасходы.Ссылка КАК Ссылка,
		|	ПриобретениеУслугПрочихАктивовРасходы.АналитикаРасходов КАК АналитикаРасходов,
		|	ПриобретениеУслугПрочихАктивовРасходы.СтатьяРасходов КАК СтатьяРасходов,
		|	ПриобретениеУслугПрочихАктивовРасходы.СуммаСНДС КАК СуммаСНДС
		|ИЗ
		|	Документ.ПриобретениеУслугПрочихАктивов.Расходы КАК ПриобретениеУслугПрочихАктивовРасходы
		|ГДЕ
		|	ПриобретениеУслугПрочихАктивовРасходы.АналитикаРасходов = &АналитикаРасходов
		|	И ПриобретениеУслугПрочихАктивовРасходы.Ссылка.Дата < &ДатаНачала
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	РасходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка.Дата,
		|	РасходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка,
		|	РасходныйКассовыйОрдерРасшифровкаПлатежа.АналитикаРасходов,
		|	РасходныйКассовыйОрдерРасшифровкаПлатежа.СтатьяРасходов,
		|	РасходныйКассовыйОрдерРасшифровкаПлатежа.Сумма
		|ИЗ
		|	Документ.РасходныйКассовыйОрдер.РасшифровкаПлатежа КАК РасходныйКассовыйОрдерРасшифровкаПлатежа
		|ГДЕ
		|	РасходныйКассовыйОрдерРасшифровкаПлатежа.АналитикаРасходов = &АналитикаРасходов
		|	И РасходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка.Дата < &ДатаНачала";
	
	Запрос.УстановитьПараметр("АналитикаРасходов", п_Заказ);
	Запрос.УстановитьПараметр("ДатаНачала", п_ДатаНачала);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Возврат Выборка.Количество() > 0;
	
КонецФункции // ()

Функция НоменклатураЕстьВДокументе(п_Заказ, п_Номенклатура)
	
	Если НЕ ЗначениеЗаполнено(п_Заказ) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для каждого Т Из п_Заказ.Товары Цикл
		Если п_Номенклатура.ЭтоГруппа Тогда
			Если Т.Номенклатура.ПринадлежитЭлементу(п_Номенклатура) Тогда
				Возврат Истина;
			КонецЕсли;
		Иначе
			Если Т.Номенклатура = п_Номенклатура Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;
КонецФункции // ()

Функция ПолучитьСуммуКорректировки(п_Заказ, п_Номенклатура)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КорректировкаРеализацииТовары.НомерСтроки КАК НомерСтроки,
	               |	КорректировкаРеализацииТовары.Номенклатура КАК Номенклатура,
	               |	КорректировкаРеализацииТовары.Сумма КАК Сумма,
	               |	КорректировкаРеализацииТовары.Количество КАК Количество
	               |ИЗ
	               |	Документ.КорректировкаРеализации.Товары КАК КорректировкаРеализацииТовары
	               |ГДЕ
	               |	КорректировкаРеализацииТовары.ЗаказКлиента = &ЗаказКлиента
	               |	И КорректировкаРеализацииТовары.Номенклатура = &Номенклатура";
	
	Запрос.УстановитьПараметр("ЗаказКлиента", п_Заказ);
	Запрос.УстановитьПараметр("Номенклатура", п_Номенклатура);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Сумма;
	КонецЕсли;		
	
	Возврат 0;
	
КонецФункции

Функция ПолучитьДокументРеализации(п_Заказ)
	
	СписокСущДокРеал = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	РеализацияТоваровУслуг.Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|ГДЕ
	|	РеализацияТоваровУслуг.ПометкаУдаления = ЛОЖЬ
	|	И РеализацияТоваровУслуг.ЗаказКлиента = &ЗаказКлиента
	|
	|УПОРЯДОЧИТЬ ПО
	|	РеализацияТоваровУслуг.Дата";
	
	Запрос.УстановитьПараметр("ЗаказКлиента", п_Заказ);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;		
	
	Возврат "";
	
КонецФункции

Функция ПолучитьЗаказПоРеализации(п_Реализация)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	РеализацияТоваровУслугТовары.ЗаказКлиента КАК ЗаказКлиента
	               |ИЗ
	               |	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	               |ГДЕ
	               |	РеализацияТоваровУслугТовары.Ссылка = &Ссылка
	               |	И РеализацияТоваровУслугТовары.Ссылка.Проведен";
	
	Запрос.УстановитьПараметр("Ссылка", п_Реализация);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ЗаказКлиента;
	КонецЕсли;		
	
	Возврат "";
	
КонецФункции

Функция ПолучитьТоварыЗаказов(п_Заказы)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
		|	ЗаказКлиентаТовары.Ссылка КАК Заказ
		|ИЗ
		|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
		|ГДЕ
		|	ЗаказКлиентаТовары.Ссылка В(&МассивЗаказов)
		|	И ЗаказКлиентаТовары.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)";
	
	Запрос.УстановитьПараметр("МассивЗаказов", п_Заказы);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции // ()

Функция ПолучитьУчетнуюЦену(п_Номенклатура, п_ВидЦены, п_Дата)

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЦеныНоменклатурыСрезПоследних.Цена КАК Цена
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
		|			&п_Дата,
		|			Номенклатура = &Номенклатура
		|				И ВидЦены = &ВидЦены) КАК ЦеныНоменклатурыСрезПоследних";
	
	Запрос.УстановитьПараметр("п_Дата", п_Дата);
	Запрос.УстановитьПараметр("ВидЦены", п_ВидЦены);
	Запрос.УстановитьПараметр("Номенклатура", п_Номенклатура);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Цена;
	КонецЕсли;
	
	Возврат 0;

КонецФункции // ()

Функция ПолучитьТЗ_ЭквайринговыеОперации(п_Заказы)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОперацияПоПлатежнойКартеРасшифровкаПлатежа.Ссылка.ЭквайринговыйТерминал КАК Терминал,
		|	ОперацияПоПлатежнойКартеРасшифровкаПлатежа.Заказ КАК Заказ,
		|	ОперацияПоПлатежнойКартеРасшифровкаПлатежа.Заказ.КаналПродажи КАК КаналПродажи,
		|	ОперацияПоПлатежнойКартеРасшифровкаПлатежа.Ссылка КАК Документ,
		|	СУММА(ОперацияПоПлатежнойКартеРасшифровкаПлатежа.Ссылка.СуммаДокумента) КАК Сумма
		|ПОМЕСТИТЬ ВТ_Документы
		|ИЗ
		|	Документ.ОперацияПоПлатежнойКарте.РасшифровкаПлатежа КАК ОперацияПоПлатежнойКартеРасшифровкаПлатежа
		|ГДЕ
		|	ОперацияПоПлатежнойКартеРасшифровкаПлатежа.Заказ В(&Заказ)
		|
		|СГРУППИРОВАТЬ ПО
		|	ОперацияПоПлатежнойКартеРасшифровкаПлатежа.Ссылка.ЭквайринговыйТерминал,
		|	ОперацияПоПлатежнойКартеРасшифровкаПлатежа.Заказ,
		|	ОперацияПоПлатежнойКартеРасшифровкаПлатежа.Заказ.КаналПродажи,
		|	ОперацияПоПлатежнойКартеРасшифровкаПлатежа.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КаналыПродаж.Ссылка КАК КаналПродажи,
		|	ВЫРАЗИТЬ(КаналыПродаж.Налог КАК ЧИСЛО(10, 2)) КАК Процент
		|ПОМЕСТИТЬ ВТ_КаналыПродаж
		|ИЗ
		|	Справочник.КаналыПродаж КАК КаналыПродаж
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЭквайринговыеТерминалыДополнительныеРеквизиты.Ссылка КАК Терминал,
		|	ВЫРАЗИТЬ(ЭквайринговыеТерминалыДополнительныеРеквизиты.Значение КАК ЧИСЛО(10, 2)) КАК Процент
		|ПОМЕСТИТЬ ВТ_Терминалы
		|ИЗ
		|	Справочник.ЭквайринговыеТерминалы.ДополнительныеРеквизиты КАК ЭквайринговыеТерминалыДополнительныеРеквизиты
		|ГДЕ
		|	ЭквайринговыеТерминалыДополнительныеРеквизиты.Свойство = &Свойство
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Документы.Заказ КАК Заказ,
		|	ВТ_Документы.Сумма КАК Сумма,
		|	ВТ_Документы.Сумма * ЕСТЬNULL(ВТ_КаналыПродаж.Процент, 0) / 100 КАК УСН,
		|	ВТ_Документы.Сумма * ЕСТЬNULL(ВТ_Терминалы.Процент, 0) / 100 КАК Комиссия,
		|	ЕСТЬNULL(ВТ_Терминалы.Процент, 0) КАК Процент,
		|	ЗаказКлиентаДополнительныеРеквизиты.Значение КАК КодПлатежнойСистемы,
		|	ВТ_Документы.Заказ.КаналПродажи КАК КаналПродажи
		|ИЗ
		|	ВТ_Документы КАК ВТ_Документы
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Терминалы КАК ВТ_Терминалы
		|		ПО ВТ_Документы.Терминал = ВТ_Терминалы.Терминал
		
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КаналыПродаж КАК ВТ_КаналыПродаж
		|		ПО ВТ_Документы.КаналПродажи = ВТ_КаналыПродаж.КаналПродажи

		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.ДополнительныеРеквизиты КАК ЗаказКлиентаДополнительныеРеквизиты
		|		ПО ВТ_Документы.Заказ = ЗаказКлиентаДополнительныеРеквизиты.Ссылка
		|			И (ЗаказКлиентаДополнительныеРеквизиты.Свойство.Наименование = ""Код платежной системы (Список заказов клиентов)"")";
	
	Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Комиссия (Эквайринговые терминалы)");
	
	Запрос.УстановитьПараметр("Свойство", Свойство);
	Запрос.УстановитьПараметр("Заказ", п_Заказы);
	
	ТЗ_ЭквайринговыеОперации = Запрос.Выполнить().Выгрузить();
    ТЗ_ЭквайринговыеОперации.Индексы.Добавить("Заказ");
	
	Возврат ТЗ_ЭквайринговыеОперации;
	
КонецФункции // ()

Функция ПолучитьТЗ_СписаниеНедостачТоваров(п_ТЗ)
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	СписаниеНедостачТоваровТовары.Ссылка.Подразделение КАК Подразделение,
		|	СписаниеНедостачТоваровТовары.Ссылка.АналитикаРасходов КАК Заказ,
		|	СписаниеНедостачТоваровТовары.Номенклатура КАК Номенклатура,
		|	СписаниеНедостачТоваровТовары.Количество КАК Количество,
		|	СписаниеНедостачТоваровТовары.Ссылка.АналитикаРасходов.КаналПродажи КАК КаналПродажи,
		|	СписаниеНедостачТоваровТовары.Ссылка.СтатьяРасходов КАК СтатьяРасходов,
		|	ЕСТЬNULL(СебестоимостьТоваровОбороты.СтоимостьРасход, 0) + ЕСТЬNULL(СебестоимостьТоваровОбороты.ДопРасходыРасход, 0) КАК Сумма
		|ИЗ
		|	Документ.СписаниеНедостачТоваров.Товары КАК СписаниеНедостачТоваровТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.СебестоимостьТоваров.Обороты(, , Регистратор, ) КАК СебестоимостьТоваровОбороты
		|		ПО СписаниеНедостачТоваровТовары.Номенклатура = СебестоимостьТоваровОбороты.АналитикаУчетаНоменклатуры.Номенклатура
		|			И СписаниеНедостачТоваровТовары.Ссылка = СебестоимостьТоваровОбороты.Регистратор
		|ГДЕ
		|	СписаниеНедостачТоваровТовары.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И СписаниеНедостачТоваровТовары.Ссылка.АналитикаРасходов ССЫЛКА Документ.ЗаказКлиента
		|	И СписаниеНедостачТоваровТовары.Ссылка.Подразделение = &Подразделение
		|	И СписаниеНедостачТоваровТовары.Ссылка.АналитикаРасходов.КаналПродажи = &КаналПродажи";
	
	
	Запрос.УстановитьПараметр("ДатаНачала", Отчет.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(Отчет.ДатаОкончания));
	
	Если ЗначениеЗаполнено(Отчет.Подразделение) Тогда
		Запрос.УстановитьПараметр("Подразделение", Отчет.Подразделение);
	Иначе	
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И СписаниеНедостачТоваровТовары.Ссылка.Подразделение = &Подразделение", "");
	КонецЕсли;

	Если ЗначениеЗаполнено(Отчет.КаналПродажи) Тогда
		Запрос.УстановитьПараметр("КаналПродажи", Отчет.КаналПродажи);
	Иначе	
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И СписаниеНедостачТоваровТовары.Ссылка.АналитикаРасходов.КаналПродажи = &КаналПродажи", "");
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	
	ТЗ_СписаниеНедостачТоваров = Запрос.Выполнить().Выгрузить();
