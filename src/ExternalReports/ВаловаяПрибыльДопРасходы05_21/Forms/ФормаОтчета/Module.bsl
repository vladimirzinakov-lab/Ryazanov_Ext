#КонецОбласти

#Область Отчет_НоменклатураЗаказы

Функция РассчитатьПоказатели2(п_Выборка, п_ТЗ)
	
	Рез = Новый Структура("Выручка, Стоимость, Прибыль, Рентабельность, ДатаРеализации, ДатаРасхода");

	Если п_Выборка = Неопределено Тогда
		НайденыСтроки = п_ТЗ;
	//ИначеЕсли ТипЗнч(п_Выборка) = Тип("СтрокаТаблицыЗначений") Тогда
	//	НайденыСтроки = п_ТЗ.НайтиСтроки(Новый Структура("Номенклатура", п_Выборка.Номенклатура));
	Иначе
		НайденыСтроки = п_ТЗ.НайтиСтроки(Новый Структура(п_Выборка.Группировка(), п_Выборка[п_Выборка.Группировка()]));
	КонецЕсли;

	Выручка = 0;
	Стоимость = 0;
	Для каждого Т Из НайденыСтроки Цикл
		Выручка = Выручка + Т.Выручка;
		Стоимость = Стоимость + Т.Стоимость;
		Если Т.ДатаРеализации > Рез.ДатаРеализации Тогда
			Рез.ДатаРеализации = Т.ДатаРеализации;
		КонецЕсли;
		Если Т.ДатаРасхода > Рез.ДатаРасхода Тогда
			Рез.ДатаРасхода = Т.ДатаРасхода;
		КонецЕсли;
	КонецЦикла;
	
	Рез.Выручка		= Выручка;
	Рез.Стоимость	= Стоимость;
	Рез.Прибыль		= Выручка - Стоимость;

	Если Стоимость <> 0 Тогда
		Рез.Рентабельность	= Рез.Прибыль / Стоимость * 100;
	КонецЕсли;
	
	Возврат Рез;
	
КонецФункции // ()

Функция СформироватьОтчетНаСервереНоменклатураЗаказы()

	УстановитьПривилегированныйРежим(Истина);

	Об = РеквизитФормыВЗначение("Отчет");
	Макет = Об.ПолучитьМакет("МакетНоменклатураЗаказ");

	Струк_ДанныеЗапросов = СобратьДанные("НоменклатураЗаказы");
	РезультатЗапроса = Струк_ДанныеЗапросов.Запрос1;
	
	ОбЗаголовок		= Макет.ПолучитьОбласть("Заголовок");
	ОбШапка			= Макет.ПолучитьОбласть("ШапкаТаблицы");
	ОбПодр			= Макет.ПолучитьОбласть("Подразделение");
	ОбКанал			= Макет.ПолучитьОбласть("Канал");
	ОбНоменкл		= Макет.ПолучитьОбласть("Номенклатура");
	ОбЗаказ			= Макет.ПолучитьОбласть("Заказ");
	ОбИтого			= Макет.ПолучитьОбласть("ИТОГО");

	Результат.Очистить();
	
	ОбЗаголовок.Параметры.ПериодОтчета	= "с " + Формат(Отчет.ДатаНачала, "ДФ=dd.MM.yyyy")  + " по " + Формат(Отчет.ДатаОкончания, "ДФ=dd.MM.yyyy");
	ОбЗаголовок.Параметры.Подразделение	= Отчет.Подразделение;
	ОбЗаголовок.Параметры.КаналПродажи	= Отчет.КаналПродажи;
	ОбЗаголовок.Параметры.Номенклатура	= Отчет.Номенклатура;
	
	Если ОтборСобственныеАктивно Тогда
		Если ОтборСобственные Тогда
			ОбЗаголовок.Параметры.Собственный_Заказной = "Собственные (складские)";
		Иначе
			ОбЗаголовок.Параметры.Собственный_Заказной = "Заказные";
		КонецЕсли;
	Иначе
		ОбЗаголовок.Параметры.Собственный_Заказной = "Все";
	КонецЕсли;
	
	Результат.Вывести(ОбЗаголовок);
	Результат.Вывести(ОбШапка);
	
	Результат.НачатьАвтогруппировкуСтрок();

	ВыборкаПодразделение = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПодразделение.Следующий() Цикл
		
		ОбПодр.Параметры.Подразделение = ВыборкаПодразделение.Подразделение;
		Результат.Вывести(ОбПодр, 1, "Группа1");

		ВыборкаКанал = ВыборкаПодразделение.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаКанал.Следующий() Цикл

			Показатели = РассчитатьПоказатели2(ВыборкаКанал, Струк_ДанныеЗапросов.ТЗ);
			ОбКанал.Параметры.Заполнить(Показатели);
			НаименованиеКанал = ПолучитьПредставлениеКанал(ВыборкаКанал.КаналПродажи);
			ОбКанал.Параметры.Канал = НаименованиеКанал;
			
			Результат.Вывести(ОбКанал, 2, "Группа2");

			ТЗ_Сортировка = Новый ТаблицаЗначений;
			ТЗ_Сортировка.Колонки.Добавить("Номенклатура",		Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
			ТЗ_Сортировка.Колонки.Добавить("Выручка",			Новый ОписаниеТипов("Число")); 
			ТЗ_Сортировка.Колонки.Добавить("Стоимость",			Новый ОписаниеТипов("Число")); 
			ТЗ_Сортировка.Колонки.Добавить("Рентабельность",	Новый ОписаниеТипов("Число")); 
			ТЗ_Сортировка.Колонки.Добавить("ДатаРеализации",	Новый ОписаниеТипов("Дата")); 
			ТЗ_Сортировка.Колонки.Добавить("ДатаРасхода",		Новый ОписаниеТипов("Дата")); 
			
			ВыборкаНоменкл = ВыборкаКанал.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаНоменкл.Следующий() Цикл
                НоваяСтрока = ТЗ_Сортировка.Добавить();
				Показатели = РассчитатьПоказатели2(ВыборкаНоменкл, Струк_ДанныеЗапросов.ТЗ);
                ЗаполнитьЗначенияСвойств(НоваяСтрока, Показатели);
				НоваяСтрока.Номенклатура = ВыборкаНоменкл.Номенклатура;
			КонецЦикла;
			
			Если ВариантСортировки = "Номенклатура" Тогда
				ТЗ_Сортировка.Сортировать("Номенклатура");
			Иначе
				ТЗ_Сортировка.Сортировать("Рентабельность");
			КонецЕсли;			

			Для каждого СтрокаТЗ_Сортировка Из ТЗ_Сортировка Цикл
			
				ОбНоменкл.Параметры.Заполнить(СтрокаТЗ_Сортировка);
				Результат.Вывести(ОбНоменкл, 3, "Группа3", Ложь);

				СтруктураПоиска = Новый Структура("Номенклатура");
				СтруктураПоиска.Номенклатура = СтрокаТЗ_Сортировка.Номенклатура;
				ВыборкаНоменкл.Сбросить();
				Если ВыборкаНоменкл.НайтиСледующий(СтруктураПоиска) Тогда
				
					ВыборкаЗаказ = ВыборкаНоменкл.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					Пока ВыборкаЗаказ.Следующий() Цикл

						Показатели = РассчитатьПоказатели2(ВыборкаЗаказ, Струк_ДанныеЗапросов.ТЗ);
						ОбЗаказ.Параметры.Заполнить(Показатели);
						ОбЗаказ.Параметры.Заказ = ВыборкаЗаказ.Заказ;
						ОбЗаказ.Параметры.РасшифровкаЗаказ = Новый Структура("Заказ", ВыборкаЗаказ.Заказ);
						Результат.Вывести(ОбЗаказ, 4, "Группа4", Ложь);
					
					КонецЦикла; // Заказ
					
				КонецЕсли;
			КонецЦикла; // Номенклатура
		КонецЦикла; // Канал
	КонецЦикла; // Подразделеиня

	Результат.ЗакончитьАвтогруппировкуСтрок();

	Показатели = РассчитатьПоказатели2(,Струк_ДанныеЗапросов.ТЗ);
	
	ОбИтого.Параметры.Заполнить(Показатели);
	
	Результат.Вывести(ОбИтого);
	
	Возврат "";
	
КонецФункции

&НаКлиенте
Процедура РезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)

	Если Не ТипЗнч(Расшифровка) = Тип("Структура") Тогда
		Возврат;
	КонецЕсли;	
	
	СтандартнаяОбработка = Ложь;
	
	РасшифровкаЗаказ = Расшифровка.Заказ;
	
	ТабДок = СформироватьОтчетНаСервереЗаказыНоменклатура();
	
	ТабДок.ОтображатьСетку = Ложь;
	ТабДок.ОтображатьЗаголовки = Ложь;
	ТабДок.ТолькоПросмотр = Истина;
	ТабДок.Показать();

КонецПроцедуры

