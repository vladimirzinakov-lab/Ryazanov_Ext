		Рез =  Новый Структура();
		Рез.Вставить("Запрос1", РезультатЗапроса);

	ИначеЕсли п_ВидОтчета = "НоменклатураЗаказы" Тогда

		ТЗ_Врем = ТЗ.Скопировать();
		ТЗ_ДляДерева = ТЗ_Врем.Скопировать(Новый Массив);
		Для каждого Т Из ТЗ_Врем Цикл
			Если ТипЗнч(Т.Номенклатура) = Тип("Строка") Тогда
				 Продолжить;
			КонецЕсли;			
			Если Т.Номенклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар Тогда
				ЗаполнитьЗначенияСвойств(ТЗ_ДляДерева.Добавить(), Т);
			КонецЕсли;			
		КонецЦикла;
		
		Запрос = Новый Запрос;
		Запрос_Текст = 
			"ВЫБРАТЬ
			|	ТЗ.Подразделение КАК Подразделение,
			|	ТЗ.КаналПродажи КАК КаналПродажи,
			|	ТЗ.Заказ КАК Заказ,
			|	ТЗ.Номенклатура КАК Номенклатура,
			|	ТЗ.Источник КАК Источник,
			|	ТЗ.Выручка КАК Выручка,
			|	ТЗ.Стоимость КАК Стоимость,
			|	ТЗ.ДатаРеализации КАК ДатаРеализации,
			|	ТЗ.ДатаРасхода КАК ДатаРасхода
			|ПОМЕСТИТЬ ВТ_ТЗ
			|ИЗ
			|	&ТЗ КАК ТЗ
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ_ТЗ.Подразделение КАК Подразделение,
			|	ВТ_ТЗ.КаналПродажи КАК КаналПродажи,
			|	ВТ_ТЗ.Заказ КАК Заказ,
			|	ВТ_ТЗ.Номенклатура КАК Номенклатура,
			|	ВТ_ТЗ.Источник КАК Источник,
			|	ВТ_ТЗ.Выручка КАК Выручка,
			|	ВТ_ТЗ.Стоимость КАК Стоимость,
			|	ВТ_ТЗ.ДатаРеализации КАК ДатаРеализации,
			|	ВТ_ТЗ.ДатаРасхода КАК ДатаРасхода
			|ИЗ
			|	ВТ_ТЗ КАК ВТ_ТЗ
			|
			|УПОРЯДОЧИТЬ ПО
			|	КаналПродажи,
			|	Номенклатура,
			|	Заказ
			|ИТОГИ
			|	СУММА(Выручка),
			|	СУММА(Стоимость),
			|	МАКСИМУМ(Источник),
			|	МАКСИМУМ(ДатаРеализации),
			|	МАКСИМУМ(ДатаРасхода)
			|ПО
			|	Подразделение,
			|	КаналПродажи,
			|	Номенклатура,
			|	Заказ";
		
		Запрос.УстановитьПараметр("ТЗ", ТЗ_ДляДерева);

		Запрос.Текст = Запрос_Текст;
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Рез =  Новый Структура();
		Рез.Вставить("Запрос1", РезультатЗапроса);
		Рез.Вставить("ТЗ", ТЗ);
		
