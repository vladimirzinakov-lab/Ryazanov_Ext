КонецФункции // списание недостач товаров

// отмененные заказы
Процедура СобратьЗаказыОтмененные(п_ТЗ)

	Запрос = Новый Запрос;
	
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ЗаказКлиентаТовары.Ссылка.Подразделение КАК Подразделение,
		|	ЗаказКлиентаТовары.Ссылка КАК Заказ,
		|	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
		|	ЗаказКлиентаТовары.Количество КАК Количество,
		|	0 КАК Выручка,
		|	ЕСТЬNULL(ЗаказКлиентаДополнительныеРеквизиты.Значение, ""Не заполнено"") КАК КодПлатежнойСистемы,
		|	ЗаказКлиентаТовары.Ссылка.КаналПродажи КАК КаналПродажи
		|ИЗ
		|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.ДополнительныеРеквизиты КАК ЗаказКлиентаДополнительныеРеквизиты
		|		ПО ЗаказКлиентаТовары.Ссылка = ЗаказКлиентаДополнительныеРеквизиты.Ссылка
		|			И (ЗаказКлиентаДополнительныеРеквизиты.Свойство.Наименование = ""Код платежной системы (Список заказов клиентов)"")
		|ГДЕ
		|	ЗаказКлиентаТовары.Ссылка.Проведен
		|	И ЗаказКлиентаТовары.Ссылка.КаналПродажи = &КаналПродажи
		|	И (ЗаказКлиентаТовары.Ссылка.СтатусЗаказаCRM = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказаCRM.Отменен)
		|			ИЛИ ЗаказКлиентаТовары.Ссылка.СтатусЗаказаCRM = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказаCRM.Отказ))
		|	И ЗаказКлиентаТовары.Ссылка.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И ЗаказКлиентаТовары.Ссылка.Подразделение = &Подразделение";
	
	
	Запрос.УстановитьПараметр("НачалоПериода",	Отчет.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода",	КонецДня(Отчет.ДатаОкончания));
	
	Если ЗначениеЗаполнено(Отчет.Подразделение) Тогда
		Запрос.УстановитьПараметр("Подразделение", Отчет.Подразделение);
	Иначе	
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И ЗаказКлиентаТовары.Ссылка.Подразделение = &Подразделение", "");
	КонецЕсли;

	Если ЗначениеЗаполнено(Отчет.КаналПродажи) Тогда
		Запрос.УстановитьПараметр("КаналПродажи", Отчет.КаналПродажи);
	Иначе	
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И ЗаказКлиентаТовары.Ссылка.КаналПродажи = &КаналПродажи", "");
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;		
	
	ТЗ_Врем = Запрос.Выполнить().Выгрузить();
	
	Для каждого Т Из ТЗ_Врем Цикл

		НайденыСтроки = п_ТЗ.НайтиСтроки(Новый Структура("Заказ, Номенклатура", Т.Заказ, Т.Номенклатура));
		Если НайденыСтроки.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = п_ТЗ.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Т);
		НоваяСтрока.Источник = "ОТ";
		//Сообщить("отмена: " + Т.Заказ);
	КонецЦикла;
	
КонецПроцедуры

// НЕ маркетплейсы
Процедура СобратьЗаказыИзРегистраПродажи(п_ТЗ)

	Запрос = Новый Запрос;
	
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ВыручкаИСебестоимостьПродажОбороты.Подразделение КАК Подразделение,
		|	ВыручкаИСебестоимостьПродажОбороты.ЗаказКлиента КАК Заказ,
		|	ВыручкаИСебестоимостьПродажОбороты.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
		|	ВыручкаИСебестоимостьПродажОбороты.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
		|	СУММА(ВыручкаИСебестоимостьПродажОбороты.СуммаВыручкиОборот) КАК Выручка,
		|	СУММА(ВыручкаИСебестоимостьПродажОбороты.КоличествоОборот) КАК Количество,
		|	СУММА(ВыручкаИСебестоимостьПродажОбороты.СтоимостьОборот) + СУММА(ВыручкаИСебестоимостьПродажОбороты.ДопРасходыОборот) КАК Стоимость,
		|	ВыручкаИСебестоимостьПродажОбороты.ЗаказКлиента.КаналПродажи КАК КаналПродажи,
		|	NULL КАК Ссылка,
		|	ВЫБОР
		|		КОГДА ВыручкаИСебестоимостьПродажОбороты.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ТипРегистратора,
		|	ВЫБОР
		|		КОГДА ВыручкаИСебестоимостьПродажОбороты.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг
		|			ТОГДА ВыручкаИСебестоимостьПродажОбороты.Регистратор.Дата
		|		ИНАЧЕ NULL
		|	КОНЕЦ КАК ДатаРеализации
		|ИЗ
		|	РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			Регистратор,
		|			ХозяйственнаяОперация <> ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ОтчетКомитенту)
		|				И Подразделение = &Подразделение) КАК ВыручкаИСебестоимостьПродажОбороты
		|ГДЕ
		|	ИСТИНА
		|	И ВыручкаИСебестоимостьПродажОбороты.ЗаказКлиента.КаналПродажи = &КаналПродажи
		|	И НЕ ВыручкаИСебестоимостьПродажОбороты.ЗаказКлиента.КаналПродажи.Маркетплейс
		|
		|СГРУППИРОВАТЬ ПО
		|	ВыручкаИСебестоимостьПродажОбороты.Подразделение,
		|	ВыручкаИСебестоимостьПродажОбороты.ЗаказКлиента,
		|	ВыручкаИСебестоимостьПродажОбороты.ХозяйственнаяОперация,
		|	ВыручкаИСебестоимостьПродажОбороты.ЗаказКлиента.КаналПродажи,
		|	ВыручкаИСебестоимостьПродажОбороты.АналитикаУчетаНоменклатуры.Номенклатура,
		|	ВЫБОР
		|		КОГДА ВыручкаИСебестоимостьПродажОбороты.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|		КОНЕЦ,
		|	ВЫБОР
		|		КОГДА ВыручкаИСебестоимостьПродажОбороты.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг
		|			ТОГДА ВыручкаИСебестоимостьПродажОбороты.Регистратор.Дата
		|		ИНАЧЕ NULL
		|	КОНЕЦ";
		
	Запрос.УстановитьПараметр("НачалоПериода",	Отчет.ДатаНачала);
	Запрос.УстановитьПараметр("КонецПериода",	КонецДня(Отчет.ДатаОкончания));
	Запрос.УстановитьПараметр("ВидЦены",		Отчет.ВидУчетнойЦены);
	
	Если ЗначениеЗаполнено(Отчет.Подразделение) Тогда
		Запрос.УстановитьПараметр("Подразделение", Отчет.Подразделение);
	Иначе	
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И Подразделение = &Подразделение", "");
	КонецЕсли;

	Если ЗначениеЗаполнено(Отчет.КаналПродажи) Тогда
		Запрос.УстановитьПараметр("КаналПродажи", Отчет.КаналПродажи);
	Иначе	
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И ВыручкаИСебестоимостьПродажОбороты.ЗаказКлиента.КаналПродажи = &КаналПродажи", "");
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;		
	
	ТЗ_Врем = Запрос.Выполнить().Выгрузить();
	
	Для каждого Т Из ТЗ_Врем Цикл
		НоваяСтрока = п_ТЗ.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Т);
		НоваяСтрока.Источник = "Р";
	КонецЦикла;
	
КонецПроцедуры

