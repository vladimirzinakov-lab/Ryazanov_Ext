Функция ПолучитьНомерЗаказаСРМ(п_Заказ)

	Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Номер заказа на сайте (Список заказов клиентов)");
	
	Рез = УправлениеСвойствами.ЗначениеСвойства(п_Заказ, Свойство);
	
	Возврат Рез;

КонецФункции // ()

Функция РассчитатьРентабельность(п_Секция, п_Выборка)
	
	Рез = Новый Структура("Прибыль,Рентабельность");
	
	Если п_Секция = "ШапкаТаблицы" Тогда
		Возврат Рез;
	КонецЕсли;
	
	Если (п_Выборка.Выручка = 0) И (п_Выборка.Стоимость = 0)Тогда
		Возврат Рез;
	КонецЕсли;

	Рез.Прибыль	= п_Выборка.Выручка - п_Выборка.Стоимость;

	Если п_Выборка.Выручка = 0 Тогда
		Возврат Рез
	КонецЕсли;
	
	Если п_Выборка.Стоимость > 0 Тогда
		Рез.Рентабельность = Рез.Прибыль / п_Выборка.Стоимость * 100;
	ИначеЕсли п_Выборка.Стоимость < 0 Тогда
		Рез.Рентабельность = - (Рез.Прибыль / п_Выборка.Стоимость * 100);
	КонецЕсли;

	Возврат Рез;

КонецФункции // ()

Процедура ПрисоединитьСекции(п_ТабДок, п_Макет, п_Секция, п_Показатели, п_Проценты = Неопределено);
	
	Если п_Проценты = Неопределено Тогда
		п_Проценты = Новый Структура;
	КонецЕсли;

	Об = п_Макет.ПолучитьОбласть(п_Секция + "|Стоимость");
	Об.Параметры.Заполнить(п_Показатели);
	Об.Параметры.Заполнить(п_Проценты);
	п_ТабДок.Присоединить(Об);

	Об = п_Макет.ПолучитьОбласть(п_Секция + "|Прибыль");
	Об.Параметры.Заполнить(п_Показатели);
	П = РассчитатьРентабельность(п_Секция, п_Показатели);
	Об.Параметры.Заполнить(П);
	п_ТабДок.Присоединить(Об);

	Об = п_Макет.ПолучитьОбласть(п_Секция + "|Рентабельность");
	Об.Параметры.Заполнить(п_Показатели);
	П = РассчитатьРентабельность(п_Секция, п_Показатели);
	Об.Параметры.Заполнить(П);
	п_ТабДок.Присоединить(Об);

КонецПроцедуры

Функция РассчитатьПоказатели(п_Выборка, п_ТЗ)
	
	Рез = Новый Структура("Стоимость, Прибыль, Рентабельность");

	Если НЕ ЗначениеЗаполнено(п_Выборка.Номенклатура) Тогда
		Возврат Рез;
	КонецЕсли;

	мСтоимость = п_ТЗ.НайтиСтроки(Новый Структура("Заказ, Номенклатура", п_Выборка.Заказ, п_Выборка.Номенклатура));
	
	Ит_Стоимость = 0;
	Ит_Сумма = 0;
	Если п_Выборка.Количество > 0 Тогда
		Для каждого Т Из мСтоимость Цикл
			Ит_Стоимость = Ит_Стоимость + Т.Стоимость;
		КонецЦикла;
		Рез.Стоимость	= Ит_Стоимость + Ит_Сумма;
		Рез.Прибыль	= п_Выборка.Выручка - (Ит_Стоимость + Ит_Сумма);
	Иначе		
		Для каждого Т Из мСтоимость Цикл
			Ит_Стоимость = Ит_Стоимость - Т.Стоимость;
		КонецЦикла;
		Рез.Стоимость	= - (Ит_Стоимость + Ит_Сумма);
		Рез.Прибыль	= п_Выборка.Выручка + (Ит_Стоимость + Ит_Сумма);
	КонецЕсли;
	
	Рез.Рентабельность = 0;
	Если Рез.Стоимость > 0 Тогда
		Рез.Рентабельность = Рез.Прибыль / Рез.Стоимость * 100;
	КонецЕсли;

	Возврат Рез;

КонецФункции // ()
 
Функция СформироватьОтчетНаСервереЗаказыНоменклатура()

	УстановитьПривилегированныйРежим(Истина);

	ТабДок = Новый ТабличныйДокумент;
	
	Об = РеквизитФормыВЗначение("Отчет");
	Макет = Об.ПолучитьМакет("МакетЗаказНоменклатура");

	Струк_ДанныеЗапросов = СобратьДанные("ЗаказыНоменклатура");
	РезультатЗапроса = Струк_ДанныеЗапросов.Запрос1;
	
	ОбЗаголовок			= Макет.ПолучитьОбласть("Заголовок|Начало");
	ОбШапкаНачало		= Макет.ПолучитьОбласть("ШапкаТаблицы|Начало");
	ОбПодрНачало		= Макет.ПолучитьОбласть("Подразделение|Начало");
	ОбКаналНачало		= Макет.ПолучитьОбласть("Канал|Начало");
	ОбЗаказНачало		= Макет.ПолучитьОбласть("Заказ|Начало");
	ОбНоменклНачало		= Макет.ПолучитьОбласть("Номенклатура|Начало");
	ОбИтогоНачало		= Макет.ПолучитьОбласть("ИТОГО|Начало");
	
	ТабДок.Очистить();
	ТабДокЗПпоМенеджерам.Очистить();
	
	ОбЗаголовок.Параметры.ПериодОтчета	= "с " + Формат(Отчет.ДатаНачала, "ДФ=dd.MM.yyyy")  + " по " + Формат(Отчет.ДатаОкончания, "ДФ=dd.MM.yyyy");
	ОбЗаголовок.Параметры.Подразделение	= Отчет.Подразделение;
	ОбЗаголовок.Параметры.КаналПродажи	= Отчет.КаналПродажи;
	
	Если ОтборСобственныеАктивно Тогда
		Если ОтборСобственные Тогда
			ОбЗаголовок.Параметры.Собственный_Заказной = "Собственные (складские)";
		Иначе
			ОбЗаголовок.Параметры.Собственный_Заказной = "Заказные";
		КонецЕсли;
	Иначе
		ОбЗаголовок.Параметры.Собственный_Заказной = "Все";
	КонецЕсли;

	ТабДок.Вывести(ОбЗаголовок);
	ТабДок.Вывести(ОбШапкаНачало);
	
	ПрисоединитьСекции(ТабДок, Макет, "ШапкаТаблицы", Новый Структура);
	
	ТабДок.НачатьАвтогруппировкуСтрок();

	ВыборкаИТОГО = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Рез = ВыборкаИТОГО.Следующий();
	Если НЕ Рез Тогда
		Возврат ТабДок;
	КонецЕсли;
	
	ЗП_ПоМенеджерам.Очистить();
	
	ВыборкаПодразделение	= ВыборкаИТОГО.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПодразделение.Следующий() Цикл
		
		ОбПодрНачало.Параметры.Заполнить(ВыборкаПодразделение);
		ТабДок.Вывести(ОбПодрНачало, 1, "Группа1");
		ПрисоединитьСекции(ТабДок, Макет, "Подразделение", ВыборкаПодразделение);

		ВыборкаКанал = ВыборкаПодразделение.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаКанал.Следующий() Цикл

			ОбКаналНачало.Параметры.Заполнить(ВыборкаКанал);
			НаименованиеКанал = ПолучитьПредставлениеКанал(ВыборкаКанал.КаналПродажи);
			ОбКаналНачало.Параметры.Канал = НаименованиеКанал;
			ТабДок.Вывести(ОбКаналНачало, 2, "Группа2");
			ПрисоединитьСекции(ТабДок, Макет, "Канал", ВыборкаКанал);

			ТЗ_Сортировка = Новый ТаблицаЗначений;
			ТЗ_Сортировка.Колонки.Добавить("Заказ",				Новый ОписаниеТипов("ДокументСсылка.ЗаказКлиента"));
			ТЗ_Сортировка.Колонки.Добавить("Выручка",			Новый ОписаниеТипов("Число")); 
			ТЗ_Сортировка.Колонки.Добавить("Стоимость",			Новый ОписаниеТипов("Число")); 
			ТЗ_Сортировка.Колонки.Добавить("Прибыль",			Новый ОписаниеТипов("Число")); 
			ТЗ_Сортировка.Колонки.Добавить("Рентабельность",	Новый ОписаниеТипов("Число")); 
			ТЗ_Сортировка.Колонки.Добавить("Проц",				Новый ОписаниеТипов("Число")); 
			ТЗ_Сортировка.Колонки.Добавить("НомерЗаказаСРМ",	Новый ОписаниеТипов("Строка")); 
			ТЗ_Сортировка.Колонки.Добавить("Источник",			Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(10)));
			ТЗ_Сортировка.Колонки.Добавить("ДатаРеализации",	Новый ОписаниеТипов("Дата")); 
			ТЗ_Сортировка.Колонки.Добавить("ДатаРасхода",		Новый ОписаниеТипов("Дата")); 

			ВыборкаЗаказ = ВыборкаКанал.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаЗаказ.Следующий() Цикл

				НоваяСтрока = ТЗ_Сортировка.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаЗаказ);

				Рез = РассчитатьРентабельность("Заказ", ВыборкаЗаказ);
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Рез);

				НоваяСтрока.НомерЗаказаСРМ = ПолучитьНомерЗаказаСРМ(ВыборкаЗаказ.Заказ);
			КонецЦикла;

			СтрЗП = ЗП_ПоМенеджерам.Добавить();
			СтрЗП.Подразделение						= ВыборкаПодразделение.Подразделение;
			СтрЗП.КодПлатежнойСистемы				= ВыборкаКанал.КодПлатежнойСистемы;
			СтрЗП.КодПлатежнойСистемыПредставление	= НаименованиеКанал;
			СтрЗП.Партнер							= ПолучитьПартнераКанал(ВыборкаКанал.КаналПродажи);
			СтрЗП.Прибыль							= ТЗ_Сортировка.Итог("Выручка") - ТЗ_Сортировка.Итог("Стоимость");
			
			Если ВариантСортировки = "ПоРентабельности" Тогда
				ТЗ_Сортировка.Сортировать("Рентабельность");
			Иначе
				ТЗ_Сортировка.Сортировать("НомерЗаказаСРМ");
			КонецЕсли;
			
			Для каждого СтрокаТЗ_Сортировка Из ТЗ_Сортировка Цикл
				
				ВыручкаЗаказа = СтрокаТЗ_Сортировка.Выручка;
				ОбЗаказНачало.Параметры.Заполнить(СтрокаТЗ_Сортировка);
				ТабДок.Вывести(ОбЗаказНачало, 3, "Группа3", Ложь);
				
				Если СтрокаТЗ_Сортировка.Заказ <> Неопределено Тогда
					СтруктураПоиска = Новый Структура("Заказ");
					СтруктураПоиска.Заказ = СтрокаТЗ_Сортировка.Заказ;
					ВыборкаЗаказ.Сбросить();
					Если ВыборкаЗаказ.НайтиСледующий(СтруктураПоиска) Тогда
						СуммаПроцентов = 0;
						СуммаПроцентов = 0;
						ВыборкаНоменклатура = ВыборкаЗаказ.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
						Пока ВыборкаНоменклатура.Следующий() Цикл
							Если ТипЗнч(ВыборкаНоменклатура.Номенклатура) = Тип("СправочникСсылка.Номенклатура")
								И ВыборкаНоменклатура.Номенклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар Тогда
									Продолжить;
							КонецЕсли;
							Если ВыручкаЗаказа <> 0 Тогда
								СуммаПроцентов = СуммаПроцентов + (ВыборкаНоменклатура.Стоимость / ВыручкаЗаказа * 100);
							КонецЕсли;
						КонецЦикла; // Номенклатура
						П = Новый Структура;
						П.Вставить("Проц",	СуммаПроцентов);
					КонецЕсли;
				КонецЕсли;
				
				ПрисоединитьСекции(ТабДок, Макет, "Заказ", СтрокаТЗ_Сортировка, П);

				Если СтрокаТЗ_Сортировка.Заказ <> Неопределено Тогда
					
					ВыборкаЗаказ.Сбросить();
					Если ВыборкаЗаказ.НайтиСледующий(СтруктураПоиска) Тогда

                        ВыборкаНоменклатура = ВыборкаЗаказ.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
						
						Пока ВыборкаНоменклатура.Следующий() Цикл
							ОбНоменклНачало.Параметры.Заполнить(ВыборкаНоменклатура);
							ОбНоменклНачало.Параметры.Источник			= СтрокаТЗ_Сортировка.Источник;
							ОбНоменклНачало.Параметры.НомерЗаказаСРМ	= СтрокаТЗ_Сортировка.НомерЗаказаСРМ;
							ТабДок.Вывести(ОбНоменклНачало, 4, "Группа4", Ложь);
							Если ВыручкаЗаказа <> 0 Тогда
								П = Новый Структура;
								П.Вставить("Проц",	ВыборкаНоменклатура.Стоимость / ВыручкаЗаказа * 100);
							КонецЕсли;
							ПрисоединитьСекции(ТабДок, Макет, "Номенклатура", ВыборкаНоменклатура, П);
						КонецЦикла; // Номенклатура
						
					КонецЕсли;
				КонецЕсли;
			КонецЦикла; // Заказы
		КонецЦикла; // Канал
		
	КонецЦикла; // Подразделеиня

	ТабДок.ЗакончитьАвтогруппировкуСтрок();

	ОбИтогоНачало.Параметры.Заполнить(ВыборкаИТОГО);
	
	ТабДок.Вывести(ОбИтогоНачало);
	ПрисоединитьСекции(ТабДок, Макет, "ИТОГО", ВыборкаИТОГО);

	Возврат ТабДок;
	
КонецФункции

#КонецОбласти

#Область Отчет_ЗарплатаПоМенеджерам

Функция ПолучитьКоэфЗП(п_Партнер)
	
	Запрос = Новый Запрос;
	Запрос_Текст = 
		"ВЫБРАТЬ
		|	Маркетплейсы_КоэффициентыЗПСрезПоследних.Коэффициент КАК Коэффициент,
		|	Маркетплейсы_КоэффициентыЗПСрезПоследних.Менеджер КАК Менеджер
		|ИЗ
		|	РегистрСведений.Маркетплейсы_КоэффициентыЗП.СрезПоследних(&ДатаСреза, Партнер = &Партнер) КАК Маркетплейсы_КоэффициентыЗПСрезПоследних
		|ГДЕ
		|	Маркетплейсы_КоэффициентыЗПСрезПоследних.Коэффициент > 0";
	
	Запрос.УстановитьПараметр("Партнер", п_Партнер);
	Запрос.УстановитьПараметр("ДатаСреза", КонецДня(Отчет.ДатаОкончания));
	
	Запрос.Текст = Запрос_Текст;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	М = Новый Массив();
	
	Пока Выборка.Следующий() Цикл
	    СтрукКоэф = Новый Структура("Менеджер,Коэффициент");
		ЗаполнитьЗначенияСвойств(СтрукКоэф, Выборка);
		М.Добавить(СтрукКоэф);
	КонецЦикла;
	
	Возврат М;

КонецФункции // ()

Функция ПолучитьПроцентЗП(пПодразделение)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КоэффициентыЗарплатыСрезПоследних.Процент КАК Процент
		|ИЗ
		|	РегистрСведений.КоэффициентыЗарплаты.СрезПоследних(&ДатаСреза, ) КАК КоэффициентыЗарплатыСрезПоследних
		|ГДЕ
		|	КоэффициентыЗарплатыСрезПоследних.Подразделение = &Подразделение";
	
	Запрос.УстановитьПараметр("Подразделение", пПодразделение);
	Запрос.УстановитьПараметр("ДатаСреза", КонецДня(ТекущаяДатаСеанса()));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Процент / 100;
	КонецЕсли;

	Запрос.УстановитьПараметр("Подразделение", Справочники.СтруктураПредприятия.ПустаяСсылка());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Процент / 100;
	КонецЕсли;
	
	Возврат 0;

КонецФункции

Процедура СформироватьОтчетЗарплатаПоМенеджерам()

	ЛогСообщить(" --- Отчет Зарплата по менеджерам --- ");
	ЛогСообщить("   -- Строк в таблице: " + ЗП_ПоМенеджерам.Количество());
	
	УстановитьПривилегированныйРежим(Истина);

	ТЗ = ЗП_ПоМенеджерам.Выгрузить(Новый Массив);
	
	Для каждого СтрТЗ_Канал Из ЗП_ПоМенеджерам Цикл

		ПроцентЗП = ПолучитьПроцентЗП(СтрТЗ_Канал.Подразделение);
		
		ЛогСообщить("Процент ЗП: " + ПроцентЗП + " " + СтрТЗ_Канал.Подразделение);
		
		ПрибыльКоэф = СтрТЗ_Канал.Прибыль * ПроцентЗП;

		ЛогСообщить("Прибыль Коэф: " + ПрибыльКоэф);
		
		МассивКоэф = ПолучитьКоэфЗП(СтрТЗ_Канал.Партнер);

		ЛогСообщить("  (1) Массив Коэф, количество: " + МассивКоэф.Количество());

		Если МассивКоэф.Количество() = 0 Тогда
			МассивКоэф = ПолучитьКоэфЗП(Справочники.Партнеры.ПустаяСсылка());
			ЛогСообщить("Массив Коэф получен по пустой ссылке Партнеры");
		КонецЕсли;

		ЛогСообщить("  (2) Массив Коэф, количество: " + МассивКоэф.Количество());

		Для каждого Т Из МассивКоэф Цикл
			НовааяСтрока = ТЗ.Добавить();
			НовааяСтрока.Менеджер							= Т.Менеджер;
			НовааяСтрока.Коэффициент						= Т.Коэффициент;
			НовааяСтрока.НачисленоЗарплата					= ПрибыльКоэф * Т.Коэффициент;
			НовааяСтрока.КодПлатежнойСистемы				= СтрТЗ_Канал.КодПлатежнойСистемы;
			НовааяСтрока.КодПлатежнойСистемыПредставление	= СтрТЗ_Канал.КодПлатежнойСистемыПредставление;
			НовааяСтрока.Прибыль							= СтрТЗ_Канал.Прибыль;
			НовааяСтрока.ПрибыльКоэф						= ПрибыльКоэф;
		КонецЦикла;
	КонецЦикла;
	
  	Об = РеквизитФормыВЗначение("Отчет");

    Схема = Об.ПолучитьМакет("СхемаКомпоновкиДанныхЗП");
	
    //Настройки = Отчет.КомпоновщикНастроек.ПолучитьНастройки();
    Настройки = Схема.НастройкиПоУмолчанию;

	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
    
    КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
    МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема, Настройки, ДанныеРасшифровки);
	
	ВнешниеНаборыДанных = Новый Структура;
    ВнешниеНаборыДанных.Вставить("ТЗ", ТЗ);
    
    ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
    ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки, Истина);	
	
	ТабДокЗПпоМенеджерам.Очистить();
	
    ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
    ПроцессорВывода.УстановитьДокумент(ТабДокЗПпоМенеджерам);
    ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);	

	ДанныеРасшифровкиЗП = ПоместитьВоВременноеХранилище(ДанныеРасшифровки, ЭтаФорма.УникальныйИдентификатор);

КонецПроцедуры

