		|	ВыручкаИСебестоимостьПродажОбороты.Период КАК Период,
		|	ВЫБОР
		|		КОГДА ВыручкаИСебестоимостьПродажОбороты.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг
		|			ТОГДА 1
		|		КОГДА ВыручкаИСебестоимостьПродажОбороты.Регистратор ССЫЛКА Документ.КорректировкаРеализации
		|			ТОГДА 2
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ТипРегистратора
		|ПОМЕСТИТЬ ВТ_Продажи
		|ИЗ
		|	РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(
		|			,
		|			,
		|			Регистратор,
		|			ХозяйственнаяОперация <> ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ОтчетКомитенту)
		|				И заказКлиента В
		|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|						ВЫРАЗИТЬ(РасходныйКассовыйОрдерРасшифровкаПлатежа.АналитикаРасходов КАК Документ.ЗаказКлиента) КАК Заказ
		|					ИЗ
		|						Документ.РасходныйКассовыйОрдер.РасшифровкаПлатежа КАК РасходныйКассовыйОрдерРасшифровкаПлатежа
		|					ГДЕ
		|						РасходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|						И НЕ ВЫРАЗИТЬ(РасходныйКассовыйОрдерРасшифровкаПлатежа.АналитикаРасходов КАК Документ.ЗаказКлиента) ЕСТЬ NULL
		|					СГРУППИРОВАТЬ ПО
		|						РасходныйКассовыйОрдерРасшифровкаПлатежа.СтатьяРасходов,
		|						ВЫРАЗИТЬ(РасходныйКассовыйОрдерРасшифровкаПлатежа.АналитикаРасходов КАК Документ.ЗаказКлиента))) КАК ВыручкаИСебестоимостьПродажОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	ВыручкаИСебестоимостьПродажОбороты.Подразделение,
		|	ВыручкаИСебестоимостьПродажОбороты.ЗаказКлиента,
		|	ВыручкаИСебестоимостьПродажОбороты.ХозяйственнаяОперация,
		|	ВыручкаИСебестоимостьПродажОбороты.АналитикаУчетаНоменклатуры.Номенклатура,
		|	ВыручкаИСебестоимостьПродажОбороты.Период,
		|	ВЫБОР
		|		КОГДА ВыручкаИСебестоимостьПродажОбороты.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг
		|			ТОГДА 1
		|		КОГДА ВыручкаИСебестоимостьПродажОбороты.Регистратор ССЫЛКА Документ.КорректировкаРеализации
		|			ТОГДА 2
		|		ИНАЧЕ 0
		|	КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Продажи.Подразделение КАК Подразделение,
		|	ВТ_Продажи.Заказ КАК Заказ,
		|	ВТ_Продажи.Номенклатура КАК Номенклатура,
		|	ВТ_Продажи.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
		|	ВТ_Продажи.Выручка КАК Выручка,
		|	ВТ_Продажи.Количество КАК Количество,
		|	ВТ_Продажи.Стоимость КАК Стоимость,
		|	ВТ_Продажи.Заказ.КаналПродажи КАК КаналПродажи,
		|	ВТ_Продажи.Период КАК Период,
		|	ВТ_Продажи.ТипРегистратора КАК ТипРегистратора
		|ИЗ
		|	ВТ_Продажи КАК ВТ_Продажи
		|ГДЕ
		|	ВТ_Продажи.Период <= &ДатаОкончания
		|	И ВТ_Продажи.Заказ.КаналПродажи = &КаналПродажи
		|	И ВТ_Продажи.Подразделение = &Подразделение
		|	И ВТ_Продажи.Заказ.КаналПродажи.Маркетплейс
		|	И ВТ_Продажи.Заказ.СтатусЗаказаCRM <> ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказаCRM.Отменен)";
	
	Запрос.УстановитьПараметр("ДатаНачала", Отчет.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(Отчет.ДатаОкончания));
	
	Если ЗначениеЗаполнено(Отчет.Подразделение) Тогда
		Запрос.УстановитьПараметр("Подразделение", Отчет.Подразделение);
	Иначе	
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И ВТ_Продажи.Подразделение = &Подразделение", "");
	КонецЕсли;

	Если ЗначениеЗаполнено(Отчет.КаналПродажи) Тогда
		Запрос.УстановитьПараметр("КаналПродажи", Отчет.КаналПродажи);
	Иначе	
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И ВТ_Продажи.Заказ.КаналПродажи = &КаналПродажи", "");
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	
	РезультатЗапроса = Запрос.Выполнить();

	ТестТЗ = РезультатЗапроса.Выгрузить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл

		НайденыСтроки = п_ТЗ.НайтиСтроки(Новый Структура("Заказ, Номенклатура", Выборка.Заказ, Выборка.Номенклатура));
		Если НайденыСтроки.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = п_ТЗ.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.Источник = "МП";
	КонецЦикла;

#КонецОбласти	
	

	// для учета корректрировки реализации, тип регистратора сбрасываем на -1	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ТипРегистратора = 2 Тогда
			НайденыСтроки = п_ТЗ.НайтиСтроки(Новый Структура("Заказ, Номенклатура, ТипРегистратора", Выборка.Заказ, Выборка.Номенклатура, 1));
			Для каждого Т Из НайденыСтроки Цикл
			    Т.Выручка = 0;
				Т.Стоимость = 0;
				Т.ТипРегистратора = -1;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	Для каждого Т Из п_ТЗ Цикл

		Если Т.ТипРегистратора = 2 Тогда
			Если НачалоМесяца(Т.Заказ.Дата) = НачалоМесяца(Т.Период) Тогда
				СуммаКорректировки = ПолучитьСуммуКорректировки(Т.Заказ, Т.Номенклатура);
			    Т.Выручка = СуммаКорректировки;
			КонецЕсли;	
		КонецЕсли;
		
		//Если ЕстьРасходПрошлыхПериодов(Т.Заказ, Отчет.ДатаНачала) Тогда
		//    Т.Выручка = СуммаКорректировки;
		//КонецЕсли;		
		
	КонецЦикла;
	
 КонецПроцедуры

 // Возвраты
Процедура СобратьЗаказыВозвраты(п_ТЗ)
	 
	Запрос = Новый Запрос;
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ВыручкаИСебестоимостьПродажОбороты.Подразделение КАК Подразделение,
		|	ВыручкаИСебестоимостьПродажОбороты.ЗаказКлиента КАК Заказ,
		|	ВыручкаИСебестоимостьПродажОбороты.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
		|	ВыручкаИСебестоимостьПродажОбороты.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
		|	СУММА(ВыручкаИСебестоимостьПродажОбороты.СуммаВыручкиОборот) КАК Выручка,
		|	СУММА(ВыручкаИСебестоимостьПродажОбороты.КоличествоОборот) КАК Количество,
		|	СУММА(ВыручкаИСебестоимостьПродажОбороты.СтоимостьОборот) + СУММА(ВыручкаИСебестоимостьПродажОбороты.ДопРасходыОборот) КАК Стоимость
		|ПОМЕСТИТЬ ВТ_Продажи
		|ИЗ
		|	РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(
		|			,
		|			,
		|			День,
		|			ЗаказКлиента В
		|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|						ВЫРАЗИТЬ(ВозвратТоваровОтКлиента.ДокументРеализации.ЗаказКлиента КАК Документ.ЗаказКлиента) КАК ЗаказКлиента
		|					ИЗ
		|						Документ.ВозвратТоваровОтКлиента КАК ВозвратТоваровОтКлиента
		|					ГДЕ
		|						ВозвратТоваровОтКлиента.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания)
		|				И (ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВозвратТоваровОтКлиентаПрошлыхПериодов)
		|					ИЛИ ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.СторноРеализации))) КАК ВыручкаИСебестоимостьПродажОбороты
		|ГДЕ
		|	ВыручкаИСебестоимостьПродажОбороты.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
		|
		|СГРУППИРОВАТЬ ПО
		|	ВыручкаИСебестоимостьПродажОбороты.Подразделение,
		|	ВыручкаИСебестоимостьПродажОбороты.ЗаказКлиента,
		|	ВыручкаИСебестоимостьПродажОбороты.ХозяйственнаяОперация,
		|	ВыручкаИСебестоимостьПродажОбороты.АналитикаУчетаНоменклатуры.Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Продажи.Подразделение КАК Подразделение,
		|	ВТ_Продажи.Заказ КАК Заказ,
		|	ВТ_Продажи.Номенклатура КАК Номенклатура,
		|	ВТ_Продажи.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
		|	ВТ_Продажи.Выручка КАК Выручка,
		|	ВТ_Продажи.Количество КАК Количество,
		|	ВТ_Продажи.Стоимость КАК Стоимость,
		|	ЕСТЬNULL(ЗаказКлиентаДополнительныеРеквизиты.Значение, ""Не заполнено"") КАК КодПлатежнойСистемы,
		|	ВТ_Продажи.Заказ.КаналПродажи КАК КаналПродажи
		|ИЗ
		|	ВТ_Продажи КАК ВТ_Продажи
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.ДополнительныеРеквизиты КАК ЗаказКлиентаДополнительныеРеквизиты
		|		ПО ВТ_Продажи.Заказ = ЗаказКлиентаДополнительныеРеквизиты.Ссылка
		|			И (ЗаказКлиентаДополнительныеРеквизиты.Свойство.Наименование = ""Код платежной системы (Список заказов клиентов)"")
		|ГДЕ
		|	ИСТИНА
		|	И ВТ_Продажи.Подразделение = &Подразделение
		|	И ВТ_Продажи.Заказ.КаналПродажи = &КаналПродажи";
	
	Запрос.УстановитьПараметр("ДатаНачала", Отчет.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(Отчет.ДатаОкончания));
	
	Если ЗначениеЗаполнено(Отчет.Подразделение) Тогда
		Запрос.УстановитьПараметр("Подразделение", Отчет.Подразделение);
	Иначе	
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И ВТ_Продажи.Подразделение = &Подразделение", "");
	КонецЕсли;

	Если ЗначениеЗаполнено(Отчет.КаналПродажи) Тогда
		Запрос.УстановитьПараметр("КаналПродажи", Отчет.КаналПродажи);
	Иначе	
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И ВТ_Продажи.Заказ.КаналПродажи = &КаналПродажи", "");
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	
	ТЗ_Врем = Запрос.Выполнить().Выгрузить();
	ТЗ_Поиск = п_ТЗ;
	ТЗ_Поиск.Индексы.Добавить("Заказ, Номенклатура");

	ЛогСообщить(" - начало цикла обр-ки возвратов -");
	Для каждого Т Из ТЗ_Врем Цикл
		
		ЛогСообщить("хоз. операция: " + Т.ХозяйственнаяОперация);
		
		НайденыСтроки = ТЗ_Поиск.НайтиСтроки(Новый Структура("Заказ, Номенклатура, Источник", Т.Заказ, Т.Номенклатура, "Р"));
		Если НайденыСтроки.Количество() > 0 Тогда
			Для каждого НайденаСтрока Из НайденыСтроки Цикл
				НайденаСтрока.Источник = "ВПП"; // возврат прошлого периода
				ЛогСообщить("   - Пометка ВПП: " + Т.Заказ);
			КонецЦикла;
			ЛогСообщить("   - Пропустили строку возврата (Р): " + Т.Заказ);
			Продолжить;
		КонецЕсли;

		НайденыСтроки = ТЗ_Поиск.НайтиСтроки(Новый Структура("Заказ, Номенклатура, Источник", Т.Заказ, Т.Номенклатура, "МП"));
		Если НайденыСтроки.Количество() > 0 Тогда
			Если Т.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СторноРеализации Тогда
				ЛогСообщить("   - Пропустили строку возврата (МП): " + Т.Заказ);
				Продолжить;
			ИначеЕсли Т.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратТоваровОтКлиентаПрошлыхПериодов Тогда
				Для каждого НайденаСтрока Из НайденыСтроки Цикл
					НайденаСтрока.Выручка = 0;
					НайденаСтрока.Стоимость = 0;
					НайденаСтрока.Количество = 0;
					НайденаСтрока.Источник = "ВПП";
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
		// строку возврата добавим только если для нее не нашлось пары с источником "Р" или "МП"
		НоваяСтрока = п_ТЗ.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Т);
		НоваяСтрока.Количество = НоваяСтрока.Количество;
		НоваяСтрока.Источник = "ВЗТ";
		
		ЛогСообщить("Добавили строку возврата: " + Т.Заказ);

	КонецЦикла;
	
 КонецПроцедуры
 
 // Заявки на возврат товаров от клиента
Процедура СобратьЗаявкиНаВозвратТоваровОтКлиента(п_ТЗ)
	 
	Запрос = Новый Запрос;
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ВыручкаИСебестоимостьПродажОбороты.Подразделение КАК Подразделение,
		|	ВыручкаИСебестоимостьПродажОбороты.ЗаказКлиента КАК Заявка,
		|	ВыручкаИСебестоимостьПродажОбороты.ЗаказКлиента.ДокументРеализации КАК Реализация,
		|	ВыручкаИСебестоимостьПродажОбороты.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
		|	СУММА(ВыручкаИСебестоимостьПродажОбороты.СуммаВыручкиОборот) КАК Выручка,
		|	СУММА(ВыручкаИСебестоимостьПродажОбороты.СтоимостьОборот) + СУММА(ВыручкаИСебестоимостьПродажОбороты.ДопРасходыОборот) КАК Стоимость,
		|	СУММА(ВыручкаИСебестоимостьПродажОбороты.КоличествоОборот) КАК Количество
		|ИЗ
		|	РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(&ДатаНачала, &ДатаОкончания, , ЗаказКлиента ССЫЛКА Документ.ЗаявкаНаВозвратТоваровОтКлиента) КАК ВыручкаИСебестоимостьПродажОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	ВыручкаИСебестоимостьПродажОбороты.Подразделение,
		|	ВыручкаИСебестоимостьПродажОбороты.ЗаказКлиента,
		|	ВыручкаИСебестоимостьПродажОбороты.ЗаказКлиента.ДокументРеализации,
		|	ВыручкаИСебестоимостьПродажОбороты.АналитикаУчетаНоменклатуры.Номенклатура";
	
	Запрос.УстановитьПараметр("ДатаНачала", Отчет.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(Отчет.ДатаОкончания));
	
	Запрос.Текст = ТекстЗапроса;
	
	ТЗ_Заявки = Запрос.Выполнить().Выгрузить();
	ТЗ_Заявки.Колонки.Добавить("Заказ", Новый ОписаниеТипов("ДокументСсылка.ЗаказКлиента"));
	
	Для каждого Т Из ТЗ_Заявки Цикл
		Т.Заказ = ПолучитьЗаказПоРеализации(Т.Реализация);
	КонецЦикла;

	ТЗ_Поиск = п_ТЗ.Скопировать();
	ТЗ_Поиск.Индексы.Добавить("Заказ, Номенклатура");

	ЛогСообщить(" - начало цикла обр-ки Заявка на возврат товаров от клиента -");
	Для каждого Т Из ТЗ_Заявки Цикл
		
		НайденыСтроки = ТЗ_Поиск.НайтиСтроки(Новый Структура("Заказ", Т.Заказ));
		Если НайденыСтроки.Количество() > 0 Тогда
			Для каждого НайденаСтрока Из НайденыСтроки Цикл
				Если ТипЗнч(НайденаСтрока.Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
					Если НайденаСтрока.Номенклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар Тогда
						Если НайденаСтрока.Количество <> 0 Тогда
							НоваяСтрока = п_ТЗ.Добавить();
							ЗаполнитьЗначенияСвойств(НоваяСтрока, НайденаСтрока);
							НоваяСтрока.Источник		= "ЗВТ";
							НоваяСтрока.Заказ			= Т.Заказ;
							НоваяСтрока.Номенклатура	= Т.Номенклатура;
							НоваяСтрока.Выручка			= Т.Выручка;
							НоваяСтрока.Стоимость		= Т.Стоимость;
							НоваяСтрока.Количество		= Т.Количество;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
 КонецПроцедуры

Функция СобратьДанные(п_ВидОтчета)

	ТЗ = Новый ТаблицаЗначений; 
	
	ТЗ.Колонки.Добавить("Подразделение",		Новый ОписаниеТипов("СправочникСсылка.СтруктураПредприятия"));
	ТЗ.Колонки.Добавить("КодПлатежнойСистемы",	Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(100)));
	ТЗ.Колонки.Добавить("КаналПродажи",			Новый ОписаниеТипов("СправочникСсылка.КаналыПродаж"));
	ТЗ.Колонки.Добавить("Заказ",				Новый ОписаниеТипов("ДокументСсылка.ЗаказКлиента"));
	
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("СправочникСсылка.Номенклатура"));
	МассивТипов.Добавить(Тип("Строка")); 
	ТЗ.Колонки.Добавить("Номенклатура",			Новый ОписаниеТипов(МассивТипов,,Новый КвалификаторыСтроки(150)));

	ТЗ.Колонки.Добавить("Выручка",				Новый ОписаниеТипов("Число")); 
	ТЗ.Колонки.Добавить("Количество",			Новый ОписаниеТипов("Число")); 
	ТЗ.Колонки.Добавить("Цена",					Новый ОписаниеТипов("Число")); 
	ТЗ.Колонки.Добавить("Стоимость",			Новый ОписаниеТипов("Число")); 
	ТЗ.Колонки.Добавить("Прибыль",				Новый ОписаниеТипов("Число")); 
	ТЗ.Колонки.Добавить("Рентабельность",		Новый ОписаниеТипов("Число")); 
	ТЗ.Колонки.Добавить("Источник",				Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(10)));
	ТЗ.Колонки.Добавить("ОтборСтатьяРасходов",	Новый ОписаниеТипов("Булево")); 
	ТЗ.Колонки.Добавить("ТипРегистратора",		Новый ОписаниеТипов("Число")); 
	ТЗ.Колонки.Добавить("Период",				Новый ОписаниеТипов("Дата")); 
	ТЗ.Колонки.Добавить("ДатаРеализации",		Новый ОписаниеТипов("Дата")); 
	ТЗ.Колонки.Добавить("ДатаРасхода",			Новый ОписаниеТипов("Дата")); 

	ТЗ.Индексы.Добавить("Подразделение, КодПлатежнойСистемы, КаналПродажи, Заказ, Номенклатура");

	Если ИсточникЗаказов = "Все" Тогда
		СобратьЗаказыИзРегистраПродажи(ТЗ);
		СобратьЗаказыИзПриобретениеУслуг(ТЗ);
		СобратьЗаказыОтмененные(ТЗ);
		СобратьЗаказыВозвраты(ТЗ);
		СобратьЗаявкиНаВозвратТоваровОтКлиента(ТЗ);

		//СобратьНедостачиТоваров(ТЗ);
	ИначеЕсли ИсточникЗаказов = "Реализация" Тогда
		СобратьЗаказыИзРегистраПродажи(ТЗ);
	ИначеЕсли ИсточникЗаказов = "ПриобретениеУслуг" Тогда
		СобратьЗаказыИзПриобретениеУслуг(ТЗ);
	ИначеЕсли ИсточникЗаказов = "Отмененные" Тогда
		СобратьЗаказыОтмененные(ТЗ);
	ИначеЕсли ИсточникЗаказов = "Возвраты" Тогда
		СобратьЗаказыВозвраты(ТЗ);
	Иначе
		Возврат "";
	КонецЕсли;

	Если ЗначениеЗаполнено(РасшифровкаЗаказ) Тогда
		ТЗ_Врем = ТЗ.Скопировать();
		ТЗ = ТЗ_Врем.Скопировать(Новый Массив);
		Для каждого Т Из ТЗ_Врем Цикл
			Если Т.Заказ = РасшифровкаЗаказ Тогда
				ЗаполнитьЗначенияСвойств(ТЗ.Добавить(), Т);
			КонецЕсли;
		КонецЦикла;
	Иначе
		Если ЗначениеЗаполнено(Отчет.Номенклатура) Тогда
			ТЗ_Врем = ТЗ.Скопировать();
			ТЗ = ТЗ_Врем.Скопировать(Новый Массив);
			Для каждого Т Из ТЗ_Врем Цикл
				Если НоменклатураЕстьВДокументе(Т.Заказ, Отчет.Номенклатура) Тогда
					ЗаполнитьЗначенияСвойств(ТЗ.Добавить(), Т);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;	

		Если Заказы.Количество() > 0 Тогда
			ТЗ_Врем = ТЗ.Скопировать();
			ТЗ = ТЗ_Врем.Скопировать(Новый Массив);
			Для каждого Т Из ТЗ_Врем Цикл
				НайденыСтроки = Заказы.НайтиСтроки(Новый Структура("ЗаказКлиента", Т.Заказ));
				Если НайденыСтроки.Количество() > 0 Тогда
					ЗаполнитьЗначенияСвойств(ТЗ.Добавить(), Т);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;	
	КонецЕсли;

	Если ОтборСобственныеАктивно Тогда
		ТЗ_Врем = ТЗ.Скопировать();
		ТЗ = ТЗ_Врем.Скопировать(Новый Массив);
		Для каждого Т Из ТЗ_Врем Цикл
			ЭтоСкладской = ПолучитьЗначениеДопРеквизитаСкладской(Т.Заказ);
			
			Если ЭтоСкладской = Неопределено Тогда
				Сообщить("Для заказа " + Т.Заказ + " не определено значение свойства Складской/Заказной");
			Иначе
				Если ОтборСобственные Тогда
					Если ЭтоСкладской Тогда
						ЗаполнитьЗначенияСвойств(ТЗ.Добавить(), Т);
					КонецЕсли;
				Иначе
					Если НЕ ЭтоСкладской Тогда
						ЗаполнитьЗначенияСвойств(ТЗ.Добавить(), Т);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
#Область СборРасходовПоДокументам

	мЗаказы = Новый Массив;
	Для каждого Т Из ТЗ Цикл
		Если Т.Количество <> 0 Тогда
			мЗаказы.Добавить(Т.Заказ);
		КонецЕсли;
	КонецЦикла;

	ТЗ_ЭквайринговыеОперации	= ПолучитьТЗ_ЭквайринговыеОперации(мЗаказы);
	ТЗ_СписаниеНедостачТоваров	= ПолучитьТЗ_СписаниеНедостачТоваров(ТЗ);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КаналыПродаж.Ссылка КАК КаналПродажи,
		|	ВЫРАЗИТЬ(КаналыПродаж.Налог КАК ЧИСЛО(10, 2)) КАК Процент
		|ПОМЕСТИТЬ ВТ_КаналыПродаж
		|ИЗ
		|	Справочник.КаналыПродаж КАК КаналыПродаж
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ДокументыРасхода.ВидДокумента КАК СТРОКА(50)) КАК ВидДокумента,
		|	ДокументыРасхода.Подразделение КАК Подразделение,
		|	ДокументыРасхода.Заказ КАК Заказ,
		|	ВЫРАЗИТЬ(ДокументыРасхода.Статья КАК СТРОКА(50)) КАК Статья,
		|	ДокументыРасхода.Сумма КАК Сумма,
		|	ДокументыРасхода.ДатаРасхода КАК ДатаРасхода,
		|	ДокументыРасхода.Заказ.КаналПродажи КАК КаналПродажи,
		|	NULL КАК КодПлатежнойСистемы
		|ИЗ
		|	(ВЫБРАТЬ
		|		""РКО"" КАК ВидДокумента,
		|		РасходныйКассовыйОрдерРасшифровкаПлатежа.Подразделение КАК Подразделение,
		|		РасходныйКассовыйОрдерРасшифровкаПлатежа.АналитикаРасходов КАК Заказ,
		|		РасходныйКассовыйОрдерРасшифровкаПлатежа.СтатьяРасходов.Наименование КАК Статья,
		|		СУММА(РасходныйКассовыйОрдерРасшифровкаПлатежа.Сумма) КАК Сумма,
		|		РасходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка.Дата КАК ДатаРасхода
		|	ИЗ
		|		Документ.РасходныйКассовыйОрдер.РасшифровкаПлатежа КАК РасходныйКассовыйОрдерРасшифровкаПлатежа
		|	ГДЕ
		|		РасходныйКассовыйОрдерРасшифровкаПлатежа.АналитикаРасходов ССЫЛКА Документ.ЗаказКлиента
		|		И РасходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка.Дата <= &ДатаОкончания
		|	
		|	СГРУППИРОВАТЬ ПО
		|		РасходныйКассовыйОрдерРасшифровкаПлатежа.Подразделение,
		|		РасходныйКассовыйОрдерРасшифровкаПлатежа.АналитикаРасходов,
		|		РасходныйКассовыйОрдерРасшифровкаПлатежа.СтатьяРасходов.Наименование,
		|		РасходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка.Дата
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ
		|		""Услуги"",
		|		ПриобретениеУслугПрочихАктивовРасходы.Подразделение,
		|		ПриобретениеУслугПрочихАктивовРасходы.АналитикаРасходов,
		|		ПриобретениеУслугПрочихАктивовРасходы.СтатьяРасходов.Наименование,
		|		СУММА(ПриобретениеУслугПрочихАктивовРасходы.СуммаСНДС),
		|		ПриобретениеУслугПрочихАктивовРасходы.Ссылка.Дата
		|	ИЗ
		|		Документ.ПриобретениеУслугПрочихАктивов.Расходы КАК ПриобретениеУслугПрочихАктивовРасходы
		|	ГДЕ
		|		ПриобретениеУслугПрочихАктивовРасходы.АналитикаРасходов ССЫЛКА Документ.ЗаказКлиента
		|		И ПриобретениеУслугПрочихАктивовРасходы.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|		И (ПриобретениеУслугПрочихАктивовРасходы.СтатьяРасходов = &СтатьяРасходов
		|					И (ВЫРАЗИТЬ(ПриобретениеУслугПрочихАктивовРасходы.АналитикаРасходов КАК Документ.ЗаказКлиента).Дата МЕЖДУ &ДатаНачала И &ДатаОкончания)
		|				ИЛИ ПриобретениеУслугПрочихАктивовРасходы.СтатьяРасходов <> &СтатьяРасходов)
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ПриобретениеУслугПрочихАктивовРасходы.Подразделение,
		|		ПриобретениеУслугПрочихАктивовРасходы.АналитикаРасходов,
		|		ПриобретениеУслугПрочихАктивовРасходы.СтатьяРасходов.Наименование,
		|		ПриобретениеУслугПрочихАктивовРасходы.Ссылка.Дата
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ
		|		""Услуги"",
		|		СписаниеЗадолженностиЗадолженность.Ссылка.Подразделение,
		|		СписаниеЗадолженностиЗадолженность.Заказ,
		|		СписаниеЗадолженностиЗадолженность.Ссылка.СтатьяРасходов.Наименование,
		|		СУММА(СписаниеЗадолженностиЗадолженность.Сумма),
		|		СписаниеЗадолженностиЗадолженность.Ссылка.Дата
		|	ИЗ
		|		Документ.СписаниеЗадолженности.Задолженность КАК СписаниеЗадолженностиЗадолженность
		|	ГДЕ
		|		СписаниеЗадолженностиЗадолженность.Заказ ССЫЛКА Документ.ЗаказКлиента
		|		И СписаниеЗадолженностиЗадолженность.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	
		|	СГРУППИРОВАТЬ ПО
		|		СписаниеЗадолженностиЗадолженность.Ссылка.Подразделение,
		|		СписаниеЗадолженностиЗадолженность.Заказ,
		|		СписаниеЗадолженностиЗадолженность.Ссылка.СтатьяРасходов.Наименование,
		|		СписаниеЗадолженностиЗадолженность.Ссылка.Дата
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ
		|		""УСН"",
		|		Док.Подразделение,
		|		Док.Ссылка,
		|		""УСН"",
		|		МАКСИМУМ(Док.СуммаДокумента * ЕСТЬNULL(ВТ_КаналыПродаж.Процент, 0) / 100),
		|		Док.Дата
		|	ИЗ
		|		Документ.ЗаказКлиента КАК Док
		|			ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КаналыПродаж КАК ВТ_КаналыПродаж
		|			ПО Док.КаналПродажи = ВТ_КаналыПродаж.КаналПродажи
		|	
		|	СГРУППИРОВАТЬ ПО
		|		Док.Ссылка,
		|		Док.Подразделение,
		|		Док.Дата) КАК ДокументыРасхода
		|ГДЕ
		|	ДокументыРасхода.Заказ В(&Заказы)";

	Запрос.УстановитьПараметр("Заказы", 		мЗаказы);
	Запрос.УстановитьПараметр("СтатьяРасходов", ПланыВидовХарактеристик.СтатьиРасходов.НайтиПоНаименованию("Агентское вознаграждение", Истина));
	Запрос.УстановитьПараметр("ДатаНачала", 	Отчет.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",	КонецДня(Отчет.ДатаОкончания));

	ТЗ_Расходы = Запрос.Выполнить().Выгрузить();
	
	Для каждого Т Из ТЗ_ЭквайринговыеОперации Цикл

		НоваяСтрока = ТЗ_Расходы.Добавить();

		НоваяСтрока.Сумма				= Т.УСН;
		НоваяСтрока.Заказ				= Т.Заказ;
		НоваяСтрока.Статья				= "УСН";
		НоваяСтрока.Подразделение		= Т.Заказ.Подразделение;
		НоваяСтрока.ВидДокумента		= "УСН";
		НоваяСтрока.КодПлатежнойСистемы	= Т.КодПлатежнойСистемы;
		НоваяСтрока.КаналПродажи		= Т.КаналПродажи;
		НоваяСтрока.ДатаРасхода			= Т.Заказ.Дата;

		НоваяСтрока = ТЗ_Расходы.Добавить();

		НоваяСтрока.Сумма				= Т.Комиссия;
		НоваяСтрока.Заказ				= Т.Заказ;
		НоваяСтрока.Статья				= "Комиссия эквайринг";
		НоваяСтрока.Подразделение		= Т.Заказ.Подразделение;
		НоваяСтрока.ВидДокумента		= "Комиссия эквайринг";
		НоваяСтрока.КодПлатежнойСистемы	= Т.КодПлатежнойСистемы;
		НоваяСтрока.КаналПродажи		= Т.КаналПродажи;
		НоваяСтрока.ДатаРасхода			= Т.Заказ.Дата;
		
	КонецЦикла;

	Для каждого Т Из ТЗ_СписаниеНедостачТоваров Цикл

		НоваяСтрока = ТЗ_Расходы.Добавить();

		НоваяСтрока.Сумма				= Т.Сумма;
		НоваяСтрока.Заказ				= Т.Заказ;
		НоваяСтрока.Статья				= Т.СтатьяРасходов;
		НоваяСтрока.Подразделение		= Т.Заказ.Подразделение;
		НоваяСтрока.ВидДокумента		= "СНТ";
		НоваяСтрока.КаналПродажи		= Т.КаналПродажи;
		НоваяСтрока.ДатаРасхода			= Т.Заказ.Дата;

		//Сообщить("добавлено в расходы СНТ: " + Т.СтатьяРасходов + " " + Т.Сумма + " " + Т.Заказ);
	КонецЦикла;
	
	ТЗ_Расходы.Индексы.Добавить("Заказ, КодПлатежнойСистемы, КаналПродажи, Подразделение");

#КонецОбласти

#Область ОбработкаТаблиц

	ЛогСообщить("Точка1, ТЗ итог Кол-во: " + ТЗ.Итог("Количество"));
	ЛогСообщить("Точка1, ТЗ итог Выручка: " + ТЗ.Итог("Выручка"));

	ТЗ.Свернуть("Подразделение, КодПлатежнойСистемы, КаналПродажи, Заказ, Номенклатура, Источник, ОтборСтатьяРасходов, ТипРегистратора, Период, ДатаРеализации, ДатаРасхода", 
		"Выручка, Количество, Цена, Стоимость, Прибыль, Рентабельность");

	// получение цены товара
	Для каждого Т Из ТЗ Цикл
		Если Т.ТипРегистратора >= 0 Тогда
			ДокРеализации = ПолучитьДокументРеализации(Т.Заказ);
			Если ЗначениеЗаполнено(ДокРеализации) Тогда
				Т.Цена = ПолучитьУчетнуюЦену(Т.Номенклатура, Отчет.ВидУчетнойЦены, ДокРеализации.Дата);
			Иначе
				Т.Цена = ПолучитьУчетнуюЦену(Т.Номенклатура, Отчет.ВидУчетнойЦены, Т.Заказ.Дата);
			КонецЕсли;
		Иначе			
			Т.Цена = 0;
		КонецЕсли;
	КонецЦикла;
	
	ТЗ.Свернуть("Подразделение, КодПлатежнойСистемы, КаналПродажи, Заказ, Номенклатура, Источник, ОтборСтатьяРасходов, Период, ДатаРеализации, ДатаРасхода",
		 "Выручка, Количество, Цена, Стоимость, Прибыль, Рентабельность");
	
	Для каждого Т Из ТЗ Цикл
		
		// для заявок на возврат удалим УСН
		Если Т.Источник = "ЗВТ" Тогда
			НайденыСтроки = ТЗ_Расходы.НайтиСтроки(Новый Структура("Заказ, Статья", Т.Заказ, "УСН"));
			Для каждого СтрокаДляУдаления Из НайденыСтроки Цикл
				ТЗ_Расходы.Удалить(СтрокаДляУдаления);
			КонецЦикла;
		КонецЕсли;
		
		// для товаров расситываем прибыль и рентабельность
		Если ТипЗнч(Т.Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
			Если Т.Номенклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар Тогда
				Если Т.Выручка = 0 Тогда
					Т.Стоимость = 0;
					Т.Прибыль = 0;
					Т.Рентабельность = 0;

					НайденыСтроки = ТЗ_Расходы.НайтиСтроки(Новый Структура("Заказ, Статья", Т.Заказ, "УСН"));
					Для каждого СтрокаДляУдаления Из НайденыСтроки Цикл
						ТЗ_Расходы.Удалить(СтрокаДляУдаления);
					КонецЦикла;
				Иначе
					Если Т.Источник <> "ВЗТ" И Т.Источник <> "ЗВТ" Тогда
						Т.Стоимость = Т.Количество * Т.Цена;
						П = РассчитатьПоказатели(Т, ТЗ);
						ЗаполнитьЗначенияСвойств(Т, П);
					КонецЕсли;
					
					// для "старых" заказов удалим строки товаров 
					СтарыеЗаказыУдалить = Новый Массив;
					Если Т.Период < Отчет.ДатаНачала Тогда
						СтарыеЗаказыУдалить.Добавить(Т);
						НайденыСтроки = ТЗ_Расходы.НайтиСтроки(Новый Структура("Заказ, Статья", Т.Заказ, "УСН"));
						Для каждого СтрокаДляУдаления Из НайденыСтроки Цикл
							ТЗ_Расходы.Удалить(СтрокаДляУдаления);
						КонецЦикла;
					КонецЕсли;
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
	
	Если СтарыеЗаказыУдалить <> Неопределено Тогда
		Для каждого Т Из СтарыеЗаказыУдалить Цикл
			ТЗ.Удалить(Т);
		КонецЦикла;
	КонецЕсли;
	
	Для каждого Т Из ТЗ_Расходы Цикл
		
		НайденыСтроки = ТЗ.НайтиСтроки(Новый Структура("Заказ", Т.Заказ));
		
		НоваяСтрока = ТЗ.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Т);
		НоваяСтрока.Номенклатура	= Т.Статья;
		НоваяСтрока.Стоимость		= Т.Сумма;
		НоваяСтрока.Выручка			= 0;
		НоваяСтрока.Количество		= 0;
		
		Если НайденыСтроки.Количество() > 0 Тогда
			НоваяСтрока.ДатаРеализации	= НайденыСтроки[0].ДатаРеализации;
			НоваяСтрока.Источник		= НайденыСтроки[0].Источник;
		КонецЕсли;
		
	КонецЦикла;

	// исключим лишние заказы, если установлен отбор по Статье расхода
	Если ЗначениеЗаполнено(ОтборСтатьяРасходов) Тогда

		Для каждого Т Из ТЗ Цикл
			Если ТипЗнч(ОтборСтатьяРасходов) = Тип("Строка") Тогда
				Если Т.Номенклатура = ОтборСтатьяРасходов Тогда
					Т.ОтборСтатьяРасходов = Истина;
				КонецЕсли;
			Иначе
				Если Строка(Т.Номенклатура) = ОтборСтатьяРасходов.Наименование Тогда
					Т.ОтборСтатьяРасходов = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		ТЗ_ЗаказыИсключить = ТЗ.Скопировать();
		ТЗ_ЗаказыИсключить.Свернуть("Заказ", "ОтборСтатьяРасходов");
		Для каждого Т Из ТЗ_ЗаказыИсключить Цикл
			Если Т.ОтборСтатьяРасходов Тогда
				Продолжить;
			КонецЕсли;
			СтрокиИсключить = ТЗ.НайтиСтроки(Новый Структура("Заказ", Т.Заказ));
			Для каждого СтрокаИсключить Из СтрокиИсключить Цикл
				ТЗ.Удалить(СтрокаИсключить);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	// для теста, удали все заказы из ТЗ кроме заказа с номером 00ЦБ-009089
	ТЗ_Исключить = ТЗ.Скопировать();
	ТЗ_Исключить.Свернуть("Заказ", "Количество, Выручка");
	Для каждого Т Из ТЗ_Исключить Цикл
		Если Т.Заказ.Номер = "00ЦБ-009089" Тогда
			Продолжить;
		КонецЕсли;
		СтрокиИсключить = ТЗ.НайтиСтроки(Новый Структура("Заказ", Т.Заказ));
		Для каждого СтрокаИсключить Из СтрокиИсключить Цикл
			ТЗ.Удалить(СтрокаИсключить);
		КонецЦикла;
	КонецЦикла;

	// Удаляем строки с ДатаРасхода меньше ДатаНачала,
	// кроме строк с Источник = "Р", у которых ДатаРеализации в текущем периоде отчета
	ТЗ_Удалить = Новый Массив;
	Для каждого Т Из ТЗ Цикл
		Если ЗначениеЗаполнено(Т.ДатаРасхода) И Т.ДатаРасхода < Отчет.ДатаНачала Тогда
			Если Т.Источник = "Р"
				И Т.ДатаРеализации >= Отчет.ДатаНачала
				И Т.ДатаРеализации <= КонецДня(Отчет.ДатаОкончания) Тогда
				Продолжить;
			КонецЕсли;
			ТЗ_Удалить.Добавить(Т);
		КонецЕсли;
	КонецЦикла;
	Для каждого Т Из ТЗ_Удалить Цикл
		ТЗ.Удалить(Т);
	КонецЦикла;
	
	ЛогСообщить("Точка2, ТЗ итог Кол-во: " + ТЗ.Итог("Количество"));
	ЛогСообщить("Точка2, ТЗ итог Выручка: " + ТЗ.Итог("Выручка"));
	
#КонецОбласти

#Область ЗапросПолученияДерева
	Если п_ВидОтчета = "ЗаказыНоменклатура" Тогда

		Запрос = Новый Запрос;
		Запрос_Текст = 
			"ВЫБРАТЬ
			|	ТЗ.Подразделение КАК Подразделение,
			|	ТЗ.КодПлатежнойСистемы КАК КодПлатежнойСистемы,
			|	ТЗ.КаналПродажи КАК КаналПродажи,
			|	ТЗ.Заказ КАК Заказ,
			|	ТЗ.Номенклатура КАК Номенклатура,
			|	ТЗ.Выручка КАК Выручка,
			|	ТЗ.Количество КАК Количество,
			|	ТЗ.Стоимость КАК Стоимость,
			|	ТЗ.Прибыль КАК Прибыль,
			|	ТЗ.Рентабельность КАК Рентабельность,
			|	ТЗ.Источник КАК Источник,
			|	ТЗ.ДатаРеализации КАК ДатаРеализации,
			|	ТЗ.ДатаРасхода КАК ДатаРасхода
			|ПОМЕСТИТЬ ВТ_ТЗ
			|ИЗ
